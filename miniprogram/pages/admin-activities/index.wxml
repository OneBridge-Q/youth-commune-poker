<block wx:if="{{mode==='create'}}">
<view class="card"><view class="heading">发布一场红圈活动</view><view class="muted">先创建草稿，确认信息后再发布。</view></view>
<view class="card">
 <view class="label">活动名称</view><input disabled="{{busy}}" value="{{title}}" bindinput="onTitle" maxlength="60" placeholder="例如：硬件产品分享会"/>
 <view class="label">活动分类</view><picker disabled="{{busy}}" mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategory"><view class="pick">{{categories[categoryIndex]}} ▼</view></picker>
 <block wx:if="{{themeOptions.length>1}}"><view class="label">首页活动主题</view><picker disabled="{{busy}}" range="{{themeOptions}}" range-key="name" value="{{themeIndex}}" bindchange="onTheme"><view class="pick">{{themeOptions[themeIndex].name}} ▼</view></picker><view class="muted">指定主题后，活动将准确展示在首页对应模块。</view></block>
 <view class="label">日期与时间</view><view class="row"><picker disabled="{{busy}}" mode="date" value="{{date}}" bindchange="onDate"><view class="pick">{{date}} ▼</view></picker><picker disabled="{{busy}}" mode="time" value="{{time}}" bindchange="onTime"><view class="pick">{{time}} ▼</view></picker></view>
 <view class="label">活动地点</view><input disabled="{{busy}}" value="{{location}}" bindinput="onLocation" maxlength="120" placeholder="输入具体场地信息"/>
 <view class="label">活动介绍</view><textarea disabled="{{busy}}" value="{{description}}" bindinput="onDescription" maxlength="500" placeholder="活动内容、适合人群、注意事项"/>
 <view class="label">活动海报（选填）</view><view class="muted">从相册选择海报，建议竖版图片，文件不超过5MB。</view>
 <image wx:if="{{posterLocalPath}}" src="{{posterLocalPath}}" mode="widthFix" style="display:block;width:100%;border-radius:14rpx;margin:18rpx 0;"/>
 <button size="mini" disabled="{{busy}}" bindtap="choosePoster">{{posterLocalPath?'重新选择海报':'上传活动海报'}}</button><button wx:if="{{posterLocalPath}}" size="mini" disabled="{{busy}}" bindtap="removePoster">移除海报</button>
 <view class="row" style="margin-top:24rpx;align-items:center;"><text>测试活动（不计正式成长）</text><switch disabled="{{busy}}" checked="{{isTest}}" bindchange="onTest"/></view>
 <button type="primary" bindtap="create" loading="{{busy}}" disabled="{{busy}}" style="margin-top:25rpx;">创建活动草稿</button>
</view>
</block>
<block wx:else>
<view class="card"><view class="heading">活动管理</view><button size="mini" disabled="{{busy}}" bindtap="load">刷新</button>
 <view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="muted">{{error}}</view>
 <view wx:for="{{activities}}" wx:key="id" class="item"><view class="event-title">{{item.title}} {{item.isTest?'[测试]':''}}</view><view class="muted">{{item.startDate}} {{item.startTime}} · {{item.category}}</view><view class="stats-row"><view data-id="{{item.id}}" data-filter="all" bindtap="viewSignups"><text>{{item.registered}}</text>已报名 ›</view><view data-id="{{item.id}}" data-filter="checked_in" bindtap="viewSignups"><text>{{item.checkedIn}}</text>已签到 ›</view><view><text>{{item.attendanceRate}}</text>签到率</view></view><view class="muted">状态：{{item.status==='draft'?'草稿':item.status==='published'?'已发布':'已取消'}}</view>
  <view wx:if="{{item.status==='published' && item.feedbackOpen}}" class="muted">问卷已开放</view>
  <view class="actions"><button wx:if="{{item.status==='published' && !item.feedbackOpen}}" size="mini" disabled="{{busy}}" data-id="{{item.id}}" data-action="openFeedback" bindtap="act">结束后开放问卷</button><button wx:if="{{item.status==='draft'}}" size="mini" type="primary" disabled="{{busy}}" data-id="{{item.id}}" data-action="publish" bindtap="act">发布</button><button wx:if="{{item.status==='draft'||item.status==='published'}}" size="mini" disabled="{{busy}}" data-id="{{item.id}}" data-action="cancel" bindtap="act">取消活动</button><button size="mini" data-id="{{item.id}}" bindtap="viewSignups">名单与签到</button><button wx:if="{{!item.isTest}}" size="mini" disabled="{{busy}}" data-id="{{item.id}}" data-action="markTest" bindtap="act">标为测试</button></view>
 </view><view wx:if="{{!activities.length&&!loading}}" class="muted">还没有活动，请从管理工作台创建。</view>
</view>
</block>
