<block wx:if="{{mode==='create'||mode==='edit'}}">
<view class="card"><view class="heading">{{mode==='edit'?'编辑活动':'发布一场红圈活动'}}</view><view class="muted">{{mode==='edit'?'已报名会员仍保留报名记录。':'先创建草稿，确认信息后再发布。'}}</view></view>
<view wx:if="{{loading}}" class="card">加载中…</view><view wx:elif="{{error}}" class="card">{{error}}</view><view wx:else class="card">
 <view class="label">活动名称</view><input disabled="{{busy}}" value="{{title}}" bindinput="onTitle" maxlength="60" placeholder="例如：硬件产品分享会"/>
 <view class="label">活动分类</view><picker disabled="{{busy}}" mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategory"><view class="pick">{{categories[categoryIndex]}} ▼</view></picker>
 <block wx:if="{{themeOptions.length>1}}"><view class="label">首页活动主题</view><picker disabled="{{busy}}" range="{{themeOptions}}" range-key="name" value="{{themeIndex}}" bindchange="onTheme"><view class="pick">{{themeOptions[themeIndex].name}} ▼</view></picker><view class="muted">指定主题后，活动将准确展示在首页对应模块。</view></block>
 <view class="label">日期与时间</view><view class="row"><picker disabled="{{busy}}" mode="date" value="{{date}}" bindchange="onDate"><view class="pick">{{date}} ▼</view></picker><picker disabled="{{busy}}" mode="time" value="{{time}}" bindchange="onTime"><view class="pick">{{time}} ▼</view></picker></view>
 <view class="label">活动地点</view><input disabled="{{busy}}" value="{{location}}" bindinput="onLocation" maxlength="120" placeholder="输入具体场地信息"/>
 <view class="label">活动介绍</view><textarea disabled="{{busy}}" value="{{description}}" bindinput="onDescription" maxlength="500" placeholder="活动内容、适合人群、注意事项"/>
 <view class="label">报名费用</view><view class="row"><text>{{feeEnabled?'付费报名':'免费报名'}}</text><switch checked="{{feeEnabled}}" disabled="{{busy}}" bindchange="onFeeEnabled"/></view>
 <block wx:if="{{feeEnabled}}"><input type="digit" value="{{feeInput}}" bindinput="onFee" disabled="{{busy}}" placeholder="报名费用（元）"/><view class="muted">微信支付尚未开通，付费活动暂不能报名。</view></block>
 <view class="label">报名人数上限（选填）</view><input type="number" value="{{capacityInput}}" bindinput="onCapacity" disabled="{{busy}}" placeholder="留空或填0表示不限人数"/>
 <view class="label">活动海报（选填）</view><view class="muted">从相册选择海报，建议竖版图片，文件不超过5MB。</view>
 <image wx:if="{{posterLocalPath||posterFileID}}" src="{{posterLocalPath||posterFileID}}" mode="widthFix" style="display:block;width:100%;border-radius:14rpx;margin:18rpx 0;"/>
 <button size="mini" disabled="{{busy}}" bindtap="choosePoster">{{posterLocalPath||posterFileID?'重新选择海报':'上传活动海报'}}</button><button wx:if="{{posterLocalPath||posterFileID}}" size="mini" disabled="{{busy}}" bindtap="removePoster">移除海报</button>
 <view wx:if="{{mode==='create'}}" class="row" style="margin-top:24rpx;align-items:center;"><text>测试活动（不计正式成长）</text><switch disabled="{{busy}}" checked="{{isTest}}" bindchange="onTest"/></view>
 <button type="primary" bindtap="create" loading="{{busy}}" disabled="{{busy}}" style="margin-top:25rpx;">{{mode==='edit'?'保存修改':'创建活动草稿'}}</button>
</view>
</block>
<block wx:else>
<view class="card"><view class="heading">活动管理</view><button size="mini" disabled="{{busy}}" bindtap="load">刷新</button>
 <view class="muted">已结束以管理员开放问卷为准；其他过开场时间的活动归入已开始。</view><view class="filter-row"><view wx:for="{{filters}}" wx:key="id" data-filter="{{item.id}}" bindtap="chooseFilter" class="filter-chip {{filter===item.id?'active':''}}">{{item.name}}</view></view>
 <view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="muted">{{error}}</view>
 <view wx:for="{{visible}}" wx:key="id" class="item"><view class="event-title">{{item.title}} {{item.isTest?'[测试]':''}}</view><view class="muted">{{item.startDate}} {{item.startTime}} · {{item.category}} · {{item.feeLabel||'免费'}} · {{item.capacity?'限'+item.capacity+'人':'不限人数'}}</view><view wx:if="{{item.feeFen>0}}" class="muted">支付尚未开通 · 暂无支付订单</view><view class="stats-row"><view data-id="{{item.id}}" data-filter="all" bindtap="viewSignups"><text>{{item.registered}}</text>已报名 ›</view><view data-id="{{item.id}}" data-filter="checked_in" bindtap="viewSignups"><text>{{item.checkedIn}}</text>已签到 ›</view><view><text>{{item.attendanceRate}}</text>签到率</view></view><view class="muted">状态：{{item.stageLabel}}</view>
  <view wx:if="{{item.status==='published' && item.feedbackOpen}}" class="muted">问卷已开放</view>
  <view class="actions"><button wx:if="{{item.canEdit}}" size="mini" disabled="{{busy}}" data-id="{{item.id}}" bindtap="edit">编辑活动</button><button wx:if="{{item.status==='published' && !item.feedbackOpen}}" size="mini" disabled="{{busy}}" data-id="{{item.id}}" data-action="openFeedback" bindtap="act">结束后开放问卷</button><button wx:if="{{item.status==='draft'}}" size="mini" type="primary" disabled="{{busy}}" data-id="{{item.id}}" data-action="publish" bindtap="act">发布</button><button wx:if="{{item.status==='draft'||item.status==='published'}}" size="mini" disabled="{{busy}}" data-id="{{item.id}}" data-action="cancel" bindtap="act">取消活动</button><button size="mini" data-id="{{item.id}}" bindtap="viewSignups">名单与签到</button><button wx:if="{{!item.isTest}}" size="mini" disabled="{{busy}}" data-id="{{item.id}}" data-action="markTest" bindtap="act">标为测试</button></view>
 </view><view wx:if="{{!visible.length&&!loading&&!error}}" class="muted">当前筛选下暂无活动。</view>
</view>
</block>
