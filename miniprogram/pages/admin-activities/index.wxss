.label{font-size:28rpx;font-weight:600;margin-top:24rpx;margin-bottom:12rpx}.pick{min-height:96rpx;box-sizing:border-box;display:flex;align-items:center;padding:16rpx 24rpx;border:1rpx solid #e4e7eb;border-radius:14rpx;font-size:32rpx}input,textarea{display:block;font-size:32rpx;line-height:1.45;border:2rpx solid #e4e7eb;border-radius:14rpx;box-sizing:border-box;width:100%}input{height:100rpx;min-height:100rpx;padding:0 24rpx}textarea{height:240rpx;padding:20rpx 24rpx}.item{padding:22rpx 0;border-bottom:1rpx solid #eff0f3}.event-title{font-size:31rpx;font-weight:600;margin-bottom:9rpx}.actions{display:flex;flex-wrap:wrap;justify-content:flex-start;gap:6rpx;margin-top:18rpx}.actions button{margin:0}
