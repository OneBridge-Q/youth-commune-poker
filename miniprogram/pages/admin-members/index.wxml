<view class="card">
 <view class="heading">指派门店管理员</view>
 <view class="muted">输入本店已注册会员的完整昵称。指派前请核对会员编号。</view>
 <input placeholder="完整昵称" value="{{keyword}}" bindinput="onKeyword" maxlength="32"/>
 <button type="primary" disabled="{{busy}}" bindtap="search">搜索会员</button>
 <view wx:if="{{error}}" class="muted">{{error}}</view>
 <view wx:if="{{searched&&!busy&&!members.length}}" class="muted">未找到可指派的同店会员。</view>
</view>
<view wx:for="{{members}}" wx:key="id" class="card">
 <view>{{item.nickname}}</view>
 <view wx:if="{{item.memberNo}}" class="muted">会员编号 {{item.memberNo}}</view>
 <button size="mini" disabled="{{busy}}" data-id="{{item.id}}" bindtap="confirm">指派为管理员</button>
</view>
