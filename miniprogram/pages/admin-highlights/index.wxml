<view class="card"><view class="heading">精彩手牌管理</view><view class="muted">管理员录入 · 审核 · 撤销</view></view>
<view class="card"><input placeholder="输入会员昵称（至少2字）" value="{{keyword}}" bindinput="onKeyword"/><button size="mini" bindtap="search">搜索会员</button><view wx:for="{{members}}" wx:key="id" class="row" data-id="{{item.id}}" data-name="{{item.nickname}}" bindtap="chooseMember"><text>{{item.nickname}}</text><text>选择</text></view></view>
<view class="card"><view>已选会员：{{memberName||'未选择'}}</view><picker mode="selector" range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="changeType"><view class="row"><text>牌型</text><text>{{types[typeIndex].label}} ▼</text></view></picker><picker mode="date" value="{{date}}" bindchange="changeDate"><view class="row"><text>发生日期</text><text>{{date}}</text></view></picker><textarea placeholder="备注（选填）" value="{{note}}" bindinput="onNote" maxlength="500"/><button type="primary" bindtap="create" loading="{{busy}}">提交待审核记录</button></view>
<view class="card"><view class="heading">待审核记录</view><button size="mini" bindtap="loadPending">刷新</button><view wx:for="{{pending}}" wx:key="id" class="row"><text>{{item.label}} · {{item.memberId}}</text><view><button size="mini" data-id="{{item.id}}" data-decision="verified" bindtap="review">通过</button><button size="mini" data-id="{{item.id}}" data-decision="rejected" bindtap="review">驳回</button></view></view><view wx:if="{{!pending.length}}" class="muted">暂无待审核记录</view></view>
<view class="card"><view class="heading">已认证记录</view><view class="muted">可撤销误录或测试记录</view><button size="mini" bindtap="loadVerified">刷新</button><view wx:for="{{verified}}" wx:key="id" class="row"><text>{{item.label}} · {{item.memberId}}</text><button size="mini" data-id="{{item.id}}" data-decision="voided" bindtap="review">撤销</button></view><view wx:if="{{!verified.length}}" class="muted">暂无已认证记录</view></view>