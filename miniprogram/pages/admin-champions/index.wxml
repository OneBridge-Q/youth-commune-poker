<view class="card"><view class="heading">SNG赛果与奖杯</view><view class="muted">为已签到的会员录入名次。保存后自动发放奖杯和战力值。</view></view>
<view class="card">
 <picker range="{{activityLabels}}" value="{{activityIndex<0?0:activityIndex}}" bindchange="chooseActivity" disabled="{{!activities.length||busy}}">
  <view class="row"><text>活动</text><text>{{activityLabels[activityIndex]||'选择正式活动'}} ›</text></view>
 </picker>
 <view wx:if="{{activityError}}" class="muted" bindtap="loadActivities">活动加载失败，点击重试</view>
 <view wx:elif="{{!activities.length}}" class="muted">暂无已开始的正式活动</view>
 <picker range="{{places}}" value="{{placeIndex}}" bindchange="choosePlace" disabled="{{busy}}">
  <view class="row"><text>名次</text><text>{{places[placeIndex]}} ›</text></view>
 </picker>
 <input placeholder="会员昵称（至少2字）" bindinput="onKeyword" value="{{keyword}}" />
 <button size="mini" bindtap="search" disabled="{{busy}}">搜索会员</button>
 <view wx:for="{{members}}" wx:key="id" class="row" bindtap="choose" data-id="{{item.id}}" data-name="{{item.nickname}}">
  <text>{{item.nickname}}</text><text>选择</text>
 </view>
 <view>已选会员 {{memberName||'未选择'}}</view>
 <button type="primary" loading="{{busy}}" disabled="{{busy||activityIndex<0||!memberId}}" bindtap="create">录入名次并发放</button>
</view>
<view wx:if="{{activityIndex>=0}}" class="card">
 <view class="heading">本场已发放奖杯</view>
 <view wx:if="{{placementError}}" class="muted" bindtap="refreshPlacements">赛果加载失败，点击重试</view>
 <view wx:for="{{placements}}" wx:key="id" class="row">
  <text>{{item.trophy}} · {{item.memberName}}</text>
  <button size="mini" data-id="{{item.id}}" data-decision="voided" bindtap="review">撤销</button>
 </view>
</view>
<view class="card"><view class="heading">待审核</view><view wx:for="{{pending}}" wx:key="id" class="row"><text>{{item.eventName}} · {{item.memberId}}</text><view><button size="mini" data-id="{{item.id}}" data-decision="verified" bindtap="review">通过</button><button size="mini" data-id="{{item.id}}" data-decision="rejected" bindtap="review">驳回</button></view></view><view wx:if="{{!pending.length}}" class="muted">暂无待审核</view></view>
<view class="card"><view class="heading">历史证书</view><view wx:for="{{verified}}" wx:key="id" class="row"><text>{{item.eventName}} · {{item.trophy}} {{item.memberName}} {{item.isTest?'[测试]':''}}</text><button wx:if="{{!item.placement}}" size="mini" data-id="{{item.id}}" data-test="{{item.isTest}}" bindtap="markTest">{{item.isTest?'恢复正式':'标为测试'}}</button><button size="mini" data-id="{{item.id}}" data-decision="voided" bindtap="review">撤销</button></view><view wx:if="{{!verified.length}}" class="muted">暂无已发放荣誉</view></view>