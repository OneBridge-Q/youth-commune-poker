<view class="card"><view class="heading">冠军证书管理</view><view class="muted">仅用于合法、无财物输赢的策略活动；测试记录不得作为真实荣誉</view></view>
<view class="card"><input placeholder="会员昵称（至少2字）" bindinput="onKeyword" value="{{keyword}}"/><button size="mini" bindtap="search">搜索会员</button><view wx:for="{{members}}" wx:key="id" class="row" bindtap="choose" data-id="{{item.id}}" data-name="{{item.nickname}}"><text>{{item.nickname}}</text><text>选择</text></view><view>已选：{{memberName||'未选择'}}</view><input placeholder="活动名称，如策略学习挑战赛" value="{{eventName}}" bindinput="onEventName" maxlength="120"/><picker mode="date" value="{{date}}" bindchange="onDate"><view class="row"><text>日期</text><text>{{date}} ▼</text></view></picker><checkbox-group bindchange="onTest"><label><checkbox value="test" checked="{{isTest}}"/>测试记录（不计入正式成长履历）</label></checkbox-group><button type="primary" loading="{{busy}}" bindtap="create">提交冠军认证</button></view>
<view class="card"><view class="heading">待审核</view><view wx:for="{{pending}}" wx:key="id" class="row"><text>{{item.eventName}} · {{item.memberId}}</text><view><button size="mini" data-id="{{item.id}}" data-decision="verified" bindtap="review">通过</button><button size="mini" data-id="{{item.id}}" data-decision="rejected" bindtap="review">驳回</button></view></view><view wx:if="{{!pending.length}}" class="muted">暂无待审核</view></view>
<view class="card"><view class="heading">已认证证书</view><view wx:for="{{verified}}" wx:key="id" class="row"><text>{{item.eventName}} · {{item.certificateId}} {{item.isTest?'[测试]':''}}</text><button size="mini" data-id="{{item.id}}" data-test="{{item.isTest}}" bindtap="markTest">{{item.isTest?'恢复正式':'标为测试'}}</button><button size="mini" data-id="{{item.id}}" data-decision="voided" bindtap="review">撤销</button></view><view wx:if="{{!verified.length}}" class="muted">暂无已认证证书</view></view>