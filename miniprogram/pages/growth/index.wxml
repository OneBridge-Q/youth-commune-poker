<view class="card">
 <view class="muted">YOUTH COMMUNE · 我的成长履历</view>
 <view wx:if="{{profile}}" class="member-head">
  <image wx:if="{{avatarSrc}}" class="member-avatar" src="{{avatarSrc}}" mode="aspectFill"/>
  <view class="member-info"><view class="heading">{{profile.nickname}}</view><view class="muted">加入青年公社：{{profile.joinedAt||'记录中'}}</view></view>
 </view>
 <view class="muted" style="margin-top:18rpx;">每一次参与，都是成长的足迹。</view>
</view>
<view wx:if="{{loading}}" class="card">正在加载你的成长履历…</view>
<view wx:if="{{error}}" class="card">{{error}}<button size="mini" bindtap="load">重试</button></view>
<block wx:if="{{summary}}">
 <view class="card"><view class="heading" style="font-size:34rpx;">成长概览</view>
  <view class="summary-grid">
   <view class="metric"><view class="metric-number">{{summary.registeredActivities}}</view><view class="muted">待签到</view></view>
   <view class="metric"><view class="metric-number">{{summary.checkedInActivities}}</view><view class="muted">已参加</view></view>
   <view class="metric"><view class="metric-number">{{summary.verifiedHonors}}</view><view class="muted">已认证荣誉</view></view>
  </view>
  <view class="muted" style="margin-top:14rpx;">仅统计真实活动的有效签到；测试记录和撤销的签到不计入已参加次数。签到不自动加分。</view>
  <navigator url="/pages/participation/index" style="margin-top:18rpx;color:#a13a35;">查看我的活动记录 ›</navigator>
 </view>
 <view class="card"><view class="heading" style="font-size:34rpx;">我的成长时间线</view>
  <view wx:for="{{timeline}}" wx:key="id" class="timeline-item"><view class="timeline-date">{{item.date||'日期待确认'}}</view><view class="timeline-title">{{item.title}}</view><view class="muted">{{item.detail}}</view></view>
  <view wx:if="{{!timeline.length}}" class="muted" style="margin-top:18rpx;">加入一次活动，开始记录你的成长故事。</view>
  <view wx:if="{{partial}}" class="muted" style="margin-top:18rpx;">当前展示部分历史记录，荣誉统计可能未覆盖全部历史。</view>
 </view>
</block>
