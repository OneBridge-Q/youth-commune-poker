page{background:#F6F4F0;color:#282320}.ranking-head{padding:42rpx 30rpx 26rpx}.eyebrow{font-size:20rpx;color:#A7473E;letter-spacing:2rpx;margin-bottom:16rpx}.board-title{font-size:44rpx;font-weight:750;line-height:1.5}.board-subtitle{font-size:25rpx;line-height:1.8;color:#83776D;margin-top:14rpx}.board-tabs{display:flex;padding:8rpx;margin:0 24rpx;background:#EAE5DD;border-radius:18rpx}.board-tab{flex:1;margin:0;background:transparent;color:#7F7064;border-radius:12rpx;line-height:80rpx;font-size:30rpx}.board-tab::after,.state-button::after{border:0}.board-tab.active{background:#FFFDF9;color:#AD3635;font-weight:700;box-shadow:0 4rpx 14rpx rgba(48,30,24,.05)}.period-strip{padding:26rpx 30rpx 20rpx;line-height:1.9}.period-title{font-size:27rpx;font-weight:600}.period-note{display:block;font-size:23rpx;color:#8B7B6E}.list-card{background:#FFFDF9;margin:0 24rpx;border-radius:22rpx;border:1rpx solid #E8E1D8;overflow:hidden}.list-heading,.rank-row{display:flex;align-items:center;padding:24rpx;box-sizing:border-box}.list-heading{background:#F0ECE5;color:#908072;font-size:23rpx}.rank-row{font-size:29rpx;border-bottom:1rpx solid #F0EBE5;min-height:110rpx}.rank-row:last-child{border-bottom:0}.position{width:72rpx;flex-shrink:0;font-size:25rpx;color:#8C7C70}.leading{color:#BC4138;font-weight:750}.name-column{flex:1;min-width:0;padding:0 12rpx;overflow-wrap:anywhere;word-break:break-all}.value{font-weight:700;font-size:33rpx;min-width:96rpx;text-align:right}.state-panel{margin:20rpx 24rpx;padding:36rpx;background:#FFFDF9;border-radius:22rpx;line-height:1.8;color:#827367;font-size:27rpx}.state-button{font-size:26rpx;line-height:68rpx;background:#EEE6DC;color:#9F4138;margin-top:22rpx}.error-text{color:#A43B38}.empty-message{padding:52rpx 30rpx;text-align:center;font-size:25rpx;color:#928073;line-height:1.8}.empty-title{font-size:31rpx;color:#5F5046;font-weight:600;margin:18rpx 0 10rpx}.empty-ring{width:48rpx;height:48rpx;border:9rpx solid #DCCFC2;border-radius:50%;margin:auto}.boa