page{background:#F6F4F0;color:#292523}.ranking-hero{padding:40rpx 30rpx 24rpx}.eyebrow{font-size:22rpx;color:#AA4138;letter-spacing:2rpx}.board-title{font-size:54rpx;font-weight:750;margin:16rpx 0}.board-subtitle{font-size:27rpx;color:#786D63;line-height:1.8}.board-tabs{display:flex;margin:0 24rpx;border-radius:20rpx;padding:8rpx;background:#E9E3DA}.board-tab{flex:1;margin:0;padding:0 12rpx;border:0;background:transparent;font-size:29rpx;line-height:80rpx;color:#74675C;border-radius:14rpx}.board-tab::after{border:0}.board-tab.active{background:#C63236;color:white}.period-title{font-size:31rpx;font-weight:650;margin-bottom:12rpx}.period-card .muted{line-height:1.9}.rule-link{font-size:25rpx;color:#A63D36;padding-top:18rpx}.my-standing{display:flex;align-items:center;justify-content:space-between}.my-score{font-size:48rpx;font-weight:700;margin-top:8rpx}.my-rank{font-size:28rpx;color:#9E3C35}.list-heading,.rank-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.list-heading{font-size:23rpx;color:#877A6E;padding-bottom:22rpx;border-bottom:1rpx solid #EDE6DE}.name-column{flex:1;min-width:0;overflow-wrap:anywhere}.list-heading>text:first-child,.position{width:66rpx;flex-shrink:0}.rank-row{padding:24rpx 4rpx;border-bottom:1rpx solid #F1EDE7;font-size:29rpx}.rank-row.is-me{background:#FFF2E9}.value{font-weight:650;flex-shrink:0}.position{font-weight:650;color:#9A5C3C}.me-tag{font-size:21rpx;color:#BD4339;margin-left:12rpx}.empty-message{font-size:27rpx;line-height:1.8;color:#88796B;padding:30rpx 0}.board-footnote{margin:0 30rpx 40rpx;font-size:24rpx;line-height:1.9;color:#887D73}.error-text{font-size:27rpx;line-height:1.8;color:#B32E35;margin-bottom:18rpx}
