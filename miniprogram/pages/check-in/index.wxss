.check-in-code { display: block; width: 430rpx; max-width: 100%; height: 430rpx; margin: 24rpx auto; }
.status { color: #80522f; margin-top: 22rpx; font-size: 26rpx; }
button { margin-top: 24rpx; }

.scanner { position:fixed; top:0; bottom:0; left:0; right:0; z-index:999; background:#17191d; }
.scan-camera { width:100%; height:100%; }
.scan-overlay { position:absolute; top:0; bottom:0; left:0; right:0; display:flex; flex-direction:column; align-items:center; justify-content:center; }
.scan-frame { position:relative; width:500rpx; height:500rpx; box-sizing:border-box; border:4rpx solid #f05b55; box-shadow:0 0 0 2000rpx rgba(0,0,0,.48); }
.scan-line { position:absolute; top:50%; left:12rpx; right:12rpx; height:3rpx; background:#f05b55; }
.scan-hint { position:relative; color:white; font-size:28rpx; margin-top:32rpx; }
.scan-actions { position:relative; display:flex; flex-wrap:wrap; justify-content:center; margin-top:24rpx; }
.scan-action { color:white; padding:20rpx; font-size:26rpx; }
