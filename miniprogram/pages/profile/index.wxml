<view class="profile-page">
 <view class="page-label"><view class="tiny-ring"></view><text>我的红圈</text><text class="page-caption">MY SPACE</text></view>
 <view class="identity-card">
  <view class="card-ring"></view>
  <view class="identity-content">
   <view class="identity-eyebrow">RED CIRCLE CLUB / MEMBER</view>
   <view wx:if="{{loading}}" class="identity-loading">正在打开你的个人名片…</view>
   <view wx:elif="{{error}}" class="identity-loading"><text>{{error}}</text><button class="light-button" bindtap="loadProfile">重新加载</button></view>
   <block wx:elif="{{registered}}">
    <view class="identity-main"><image wx:if="{{avatarSrc}}" class="profile-avatar" src="{{avatarSrc}}" mode="aspectFill" binderror="onAvatarError"/><view wx:else class="avatar-fallback">{{initial}}</view><view class="identity-text"><view class="profile-name">{{nickname}}</view><view class="profile-tagline">以兴趣相遇，以共创同行。</view></view><button class="edit-button" bindtap="editProfile">编辑资料 ›</button></view>
    <view class="personal-scores"><view class="personal-score"><text class="score-label">我的战力值</text><text class="score-value">{{skillDisplay}}</text><text class="score-caption">长期累计 · 不按季清零</text></view><view class="score-divider"></view><view class="personal-score charm-score" bindtap="openCharisma"><text class="score-label">我的魅力值 <text class="score-arrow">›</text></text><text class="score-value">{{charmDisplay}}</text><text class="score-caption">可兑换余额 · 规则说明</text></view></view>
   </block>
   <view wx:else class="guest-block"><view class="guest-title">让每次相遇，留下成长。</view><view class="profile-tagline">创建个人档案，开始你的红圈旅程。</view><button class="light-button" bindtap="openRegister">加入红圈</button></view>
  </view>
 </view>
 <block wx:if="{{registered&&!loading&&!error}}">
  <view class="shortcut-grid"><view class="shortcut" bindtap="openGrowth"><view class="shortcut-icon">迹</view><view class="shortcut-title">成长履历 <text>↗</text></view><view class="shortcut-note">回看你的参与和收获</view></view><view class="shortcut" bindtap="openHighlights"><view class="shortcut-icon secondary">荣</view><view class="shortcut-title">精彩手牌 <text>↗</text></view><view class="shortcut-note">记录值得分享的时刻</view></view></view>
  <navigator url="/pages/member-recaps/index" class="section-card"><view class="section-name">我的季度与年度回顾 ›</view><view class="shortcut-note"><block wx:if="{{recapLabels.length}}">已生成回顾：{{recapLabels[0]}}{{recapLabels.length>1?' · '+recapLabels[1]:''}}</block><block wx:else>回看参加的活动、玩法评价和精彩手牌</block></view></navigator>
  <navigator url="/pages/participation/index" class="section-card"><view class="section-name">我已参加 · 活动记录 ›</view><view class="shortcut-note">查看到场签到、待签到报名与测试记录</view></navigator>
  <view class="section-card">
   <view class="section-heading"><view><view class="section-kicker">MY ACTIVITIES</view><view class="section-name">已报名 · 待签到</view></view><view class="section-link" bindtap="openActivities">发现活动 ›</view></view>
   <view wx:if="{{activitiesLoading}}" class="section-state">报名记录加载中…</view>
   <view wx:elif="{{activitiesError}}" class="section-state error-state" bindtap="retryActivities">{{activitiesError}}，点击重试</view>
   <block wx:else><view wx:for="{{activityPreview}}" wx:key="activityId" class="detail-row" data-id="{{item.activityId}}" bindtap="openActivity"><view class="row-mark"></view><view class="row-content"><view class="row-title">{{item.title}} {{item.isTest?'[测试]':''}}</view><view class="row-subtitle">{{item.startDate}} · {{item.startTime}}</view></view><text class="row-chevron">›</text></view><view wx:if="{{!myActivities.length}}" class="section-state">暂无待签到的报名，去发现一次新的相遇。</view><view wx:if="{{myActivities.length>3}}" class="expand-link" bindtap="toggleActivities">{{showAllActivities?'收起':'查看全部报名'}} {{showAllActivities?'⌃':'⌄'}}</view></block>
  </view>
  <view class="section-card">
   <view class="section-heading"><view><view class="section-kicker">MY HONORS</view><view class="section-name">我的冠军荣誉</view></view><text wx:if="{{!championsLoading && !championsError && champions.length}}" class="section-tag">已认证</text></view>
   <view wx:if="{{championsLoading}}" class="section-state">荣誉记录加载中…</view>
   <view wx:elif="{{championsError}}" class="section-state error-state" bindtap="retryChampions">{{championsError}}，点击重试</view>
   <block wx:else><view wx:for="{{championPreview}}" wx:key="id" class="detail-row" data-id="{{item.id}}" bindtap="openChampion"><view class="honor-star">✦</view><view class="row-content"><view class="row-title">{{item.eventName}}</view><view class="row-subtitle">查看专属荣誉证书</view></view><text class="row-chevron">›</text></view><view wx:if="{{!champions.length}}" class="section-state">属于你的荣誉时刻，值得慢慢积累。</view><view wx:if="{{champions.length>3}}" class="expand-link" bindtap="toggleChampions">{{showAllChampions?'收起':'查看全部荣誉'}} {{showAllChampions?'⌃':'⌄'}}</view></block>
  </view>
  <view wx:if="{{isAdmin}}" class="section-card admin-card">
   <view class="section-heading" bindtap="toggleAdmin"><view><view class="section-kicker">OPERATIONS</view><view class="section-name">管理工作台</view></view><text class="section-link">{{adminExpanded?'收起 ⌃':'展开 ⌄'}}</text></view>
   <view wx:if="{{!adminExpanded}}" class="admin-summary">活动发布、签到、回顾、精彩手牌与冠军认证</view>
   <view wx:else class="admin-grid"><view bindtap="openActivityAdmin">活动与签到 <text>›</text></view><view bindtap="openRecapAdmin">活动回顾 <text>›</text></view><view bindtap="openAdmin">精彩手牌管理 <text>›</text></view><view bindtap="openChampionAdmin">冠军证书管理 <text>›</text></view></view>
  </view>
 </block>
 <view wx:if="{{!registered&&!loading&&!error}}" class="discover-card" bindtap="openActivities"><view class="section-name">先逛逛红圈活动 ↗</view><view class="shortcut-note">智力竞技 · 兴趣社交 · 青年共创</view></view>
 <view class="profile-footer">红圈 club · 让兴趣与成长同行</view>
</view>
