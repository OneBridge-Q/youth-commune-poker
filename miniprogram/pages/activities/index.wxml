<view class="card"><view class="muted">红圈青年 · 深圳南山</view><view class="heading">一起参与，一起成长</view><view class="muted">从一次相遇，开始新的可能</view></view>
<view wx:if="{{product}}" class="card"><view class="heading">{{product.name}}</view><view class="muted" style="margin-top:16rpx;line-height:1.8;">{{product.description}}</view><view class="muted" style="margin-top:16rpx;">以下是与该类型相关的近期场次；没有排期时不会自动创建活动。</view><button size="mini" bindtap="clearProduct" style="margin-top:20rpx;">查看全部活动</button></view>
<scroll-view scroll-x="true" class="filter"><view class="filter-inner"><view wx:for="{{categories}}" wx:key="*this" data-value="{{item}}" bindtap="chooseCategory" class="filter-chip {{selected===item?'selected':''}}">{{item}}</view></view></scroll-view>
<view wx:if="{{loading}}" class="card"><view class="muted">活动加载中…</view></view>
<view wx:if="{{error}}" class="card"><view class="error">{{error}}</view><button size="mini" bindtap="load">重试</button></view>
<view wx:for="{{visible}}" wx:key="id" class="card activity-card" data-id="{{item.id}}" bindtap="open"><image wx:if="{{item.posterSrc}}" src="{{item.posterSrc}}" mode="aspectFill" class="event-cover"/><view class="row"><text class="category">{{item.category}} · {{item.feeLabel||'免费'}}</text><text class="muted">{{item.startDate}} {{item.startTime}}</text></view><view class="activity-title">{{item.title}}</view><view class="muted">📍 {{item.location}}</view><view class="activity-more">查看详情与报名 ›</view></view>
<view wx:if="{{!loading&&!error&&!visible.length}}" class="card"><view class="muted">{{product?'这一类型暂未发布近期场次，敬请期待。':'这个分类暂时没有活动，敬请期待。'}}</view></view>
