<import src="../../templates/value-rule.wxml"/>
<view class="card charisma-card">
 <view class="heading">我的魅力值</view>
 <view wx:if="{{loading}}" class="muted balance-message">正在加载…</view>
 <view wx:elif="{{error}}" class="balance-message">{{error}}<button size="mini" bindtap="load">重试</button></view>
 <block wx:elif="{{registered}}"><view class="balance-number">{{attended}}</view><view class="muted">累计有效签到场次</view></block>
 <button wx:else type="primary" bindtap="register">注册后查看我的魅力值</button>
</view>
<template is="value-rule"/>
