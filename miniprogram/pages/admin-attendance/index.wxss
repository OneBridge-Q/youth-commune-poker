.numbers{display:flex;justify-content:space-around;margin:28rpx 0}.numbers view{text-align:center;font-size:24rpx;color:#777}.numbers text{display:block;font-size:44rpx;font-weight:700;color:#26334a}.search{display:flex;align-items:center;gap:16rpx}.search input{min-width:0;flex:1;font-size:26rpx}.search button{flex-shrink:0}.tabs{display:flex;margin:24rpx 0;gap:10rpx}.tabs button{margin:0;flex:1;font-size:25rpx}.tabs .active{background:#202b3c;color:#fff}.person{padding:26rpx 0;border-top:1rpx solid #eee}.person-name{font-weight:650;font-size:32rpx}.person-actions{display:flex;gap:16rpx;margin-top:16rpx}.person-actions button{margin:0}.test-label{color:#9b672a;font-size:24rpx;line-height:1.8;margin-top:10rpx}.error{color:#b3333b;font-size:26rpx;line-height:1.8;margin:16rpx 0}.overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;z-index:99;padding:30rpx}.dialog{background:#fff;border-radius:24rpx;padding:30rpx;width:100%;box-sizing:border-box;max-height:85vh;overflow-y:auto}.dialog textarea{box-sizing:border-box;width:100%;height:180rpx;border:1rpx solid #ddd;padding:16rpx;margin:24rpx 0}.dialog button{margin-top:16rpx}
