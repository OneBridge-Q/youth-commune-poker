<view class="card"><view class="heading">精彩手牌</view><view class="muted">仅统计管理员审核通过的记录</view><view class="heading">{{total}} 次</view><view wx:if="{{partial}}" class="muted">当前仅展示最近100条记录，累计总数待接入聚合统计</view></view><view class="card"><view wx:for="{{counts}}" wx:key="name" class="row"><text>{{item.name}}</text><text>{{item.count}} 次</text></view></view><view class="card"><view class="heading">最近记录</view><view wx:for="{{recent}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="openMoment"><text>{{item.name}}</text><text>生成海报 ›</text></view><view wx:if="{{!recent.length}}" class="muted">暂无精彩手牌</view></view><view wx:if="{{error}}" class="card">{{error}}</view>